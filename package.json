{
  "name": "deadline-graveyard",
  "version": "0.1.0",
  "private": true,
  "description": "A deadline and project tracker where a moonlit graveyard is the interface.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:related": "vitest related --run",
    "test:e2e": "playwright test",
    "audit:a11y": "node scripts/audit.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.1",
    "idb": "^8.0.4",
    "preact": "^11.2.0",
    "temporal-polyfill": "^1.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^7.29.13",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "chrome-launcher": "^1.2.3",
    "eslint": "^10.15.0",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "lighthouse": "^12.8.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
